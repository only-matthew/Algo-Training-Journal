{
  "name": "algo-training-journal",
  "version": "2.1.0",
  "private": true,
  "description": "队伍训练日志 - 热力图",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "sync:katex": "node scripts/sync-katex.mjs",
    "generate": "node scripts/generate-data.js",
    "report:period": "node scripts/period-report.mjs",
    "build": "npm run generate",
    "deploy:worker": "node scripts/stamp-worker-commit.mjs && wrangler deploy --config workers/wrangler.toml",
    "sync:difficulty": "node scripts/sync-missing-difficulty.mjs --write",
    "training:reindex": "node scripts/reindex-training.mjs",
    "test": "node scripts/run-tests.mjs",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:ci": "playwright test",
    "check:syntax": "node scripts/check-syntax.mjs",
    "check:lint": "eslint src/*.js lib scripts workers bot test e2e eslint.config.mjs playwright.config.mjs",
    "preview": "node scripts/preview-ui.mjs",
    "smoke:attachment": "node scripts/smoke-attachment.mjs",
    "smoke:details": "node scripts/smoke-details.mjs",
    "smoke:statement": "node scripts/smoke-statement-import.mjs",
    "smoke:submission": "node scripts/smoke-submission-page.mjs",
    "smoke:scale": "node scripts/smoke-scale.mjs",
    "probe:workerd": "node scripts/probe-workerd-multipart.mjs",
    "verify": "npm run check:syntax && npm run check:lint && npm run training:reindex -- --check && npm test && npm run build",
    "check": "npm run verify",
    "verify:parallel": "node scripts/verify-parallel.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "esbuild": "0.28.1",
    "eslint": "^10.11.0",
    "globals": "^16.5.0",
    "katex": "0.18.2",
    "wrangler": "^4.147.0"
  },
  "dependencies": {
    "@noble/ed25519": "^3.1.0",
    "@noble/hashes": "^2.3.0",
    "cheerio": "^1.2.0",
    "marked": "^18.0.7"
  }
}
